generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum StoreStatus {
  ACTIVE
  INACTIVE
}

enum MembershipRole {
  OWNER
  MANAGER
  CASHIER
  STOCK
}

enum MembershipStatus {
  ACTIVE
  INACTIVE
}

enum CatalogStatus {
  ACTIVE
  INACTIVE
}

enum ProductUnit {
  UNIT
  KILOGRAM
  GRAM
  LITER
  MILLILITER
  PACKAGE
}

enum StockMovementType {
  INITIAL
  RECEIPT
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  SALE
  RETURN
  SALE_REVERSAL
}

enum InventoryStatus {
  DRAFT
  CONFIRMED
}

enum CashSessionStatus {
  OPEN
  CLOSED
}

enum SaleStatus {
  CONFIRMED
  CANCELED
  PARTIALLY_RETURNED
}

enum PaymentMethod {
  CASH
  PIX
  CARD
  CREDIT
}

enum ReceivableStatus {
  OPEN
  PAID
  CANCELED
}

model Organization {
  id           String              @id @default(cuid())
  name         String
  slug         String              @unique
  status       OrganizationStatus  @default(ACTIVE)
  timezone     String              @default("America/Sao_Paulo")
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  stores       Store[]
  audit        AuditEvent[]
  memberships  Membership[]
  categories   Category[]
  products     Product[]
  suppliers    Supplier[]
  customers    Customer[]
  services     Service[]
  cashSessions CashSession[]
  sales        Sale[]
  receivables  AccountReceivable[]
}

model Store {
  id             String              @id @default(cuid())
  organizationId String
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  name           String
  slug           String
  status         StoreStatus         @default(ACTIVE)
  timezone       String              @default("America/Sao_Paulo")
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  audit          AuditEvent[]
  access         StoreAccess[]
  categories     Category[]
  products       Product[]
  suppliers      Supplier[]
  customers      Customer[]
  services       Service[]
  cashSessions   CashSession[]
  sales          Sale[]
  receivables    AccountReceivable[]

  @@unique([organizationId, slug])
  @@index([organizationId, status])
}

model Category {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  storeId        String
  store          Store         @relation(fields: [storeId], references: [id], onDelete: Restrict)
  name           String
  slug           String
  status         CatalogStatus @default(ACTIVE)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  products       Product[]
  services       Service[]

  @@unique([storeId, slug])
  @@index([organizationId, storeId, status])
}

model Product {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  storeId        String
  store          Store           @relation(fields: [storeId], references: [id], onDelete: Restrict)
  categoryId     String?
  category       Category?       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  name           String
  sku            String
  barcode        String?
  unit           ProductUnit     @default(UNIT)
  salePrice      Decimal         @db.Decimal(14, 2)
  referenceCost  Decimal         @db.Decimal(14, 2)
  minimumStock   Decimal         @default(0) @db.Decimal(14, 3)
  taxNotes       String?
  status         CatalogStatus   @default(ACTIVE)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  stockBalance   StockBalance?
  stockMovements StockMovement[]
  inventoryItems InventoryItem[]
  saleItems      SaleItem[]

  @@unique([storeId, sku])
  @@unique([storeId, barcode])
  @@index([organizationId, storeId, status])
  @@index([organizationId, name])
}

model StockBalance {
  id             String   @id @default(cuid())
  organizationId String
  storeId        String
  productId      String   @unique
  product        Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity       Decimal  @default(0) @db.Decimal(14, 3)
  averageCost    Decimal  @default(0) @db.Decimal(14, 4)
  updatedAt      DateTime @updatedAt

  @@index([organizationId, storeId])
}

model StockMovement {
  id             String            @id @default(cuid())
  organizationId String
  storeId        String
  productId      String
  product        Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  type           StockMovementType
  quantity       Decimal           @db.Decimal(14, 3)
  unitCost       Decimal           @db.Decimal(14, 4)
  balanceAfter   Decimal           @db.Decimal(14, 3)
  referenceType  String?
  referenceId    String?
  lotNumber      String?
  expiresAt      DateTime?
  reason         String?
  actorId        String
  occurredAt     DateTime          @default(now())

  @@index([organizationId, storeId, occurredAt])
  @@index([productId, occurredAt])
}

model InventoryCount {
  id             String          @id @default(cuid())
  organizationId String
  storeId        String
  status         InventoryStatus @default(DRAFT)
  notes          String?
  actorId        String
  confirmedAt    DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  items          InventoryItem[]

  @@index([organizationId, storeId, createdAt])
}

model InventoryItem {
  id               String         @id @default(cuid())
  inventoryCountId String
  inventoryCount   InventoryCount @relation(fields: [inventoryCountId], references: [id], onDelete: Restrict)
  productId        String
  product          Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  expectedQuantity Decimal        @db.Decimal(14, 3)
  countedQuantity  Decimal        @db.Decimal(14, 3)
  adjustmentId     String?

  @@unique([inventoryCountId, productId])
}

model Supplier {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  storeId        String
  store          Store         @relation(fields: [storeId], references: [id], onDelete: Restrict)
  name           String
  document       String?
  email          String?
  phone          String?
  status         CatalogStatus @default(ACTIVE)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([organizationId, storeId, status])
  @@index([organizationId, name])
}

model Customer {
  id             String              @id @default(cuid())
  organizationId String
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  storeId        String
  store          Store               @relation(fields: [storeId], references: [id], onDelete: Restrict)
  name           String
  document       String?
  email          String?
  phone          String?
  petName        String?
  status         CatalogStatus       @default(ACTIVE)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  sales          Sale[]
  receivables    AccountReceivable[]

  @@index([organizationId, storeId, status])
  @@index([organizationId, name])
}

model Service {
  id              String        @id @default(cuid())
  organizationId  String
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  storeId         String
  store           Store         @relation(fields: [storeId], references: [id], onDelete: Restrict)
  categoryId      String?
  category        Category?     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  name            String
  code            String
  salePrice       Decimal       @db.Decimal(14, 2)
  estimatedCost   Decimal       @db.Decimal(14, 2)
  durationMinutes Int?
  status          CatalogStatus @default(ACTIVE)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  saleItems       SaleItem[]

  @@unique([storeId, code])
  @@index([organizationId, storeId, status])
  @@index([organizationId, name])
}

model User {
  id            String        @id @default(cuid())
  name          String
  email         String        @unique
  emailVerified Boolean       @default(false)
  image         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  sessions      Session[]
  accounts      Account[]
  memberships   Membership[]
  storeAccess   StoreAccess[]
  cashSessions  CashSession[]
  sales         Sale[]
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model Membership {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  role           MembershipRole
  status         MembershipStatus @default(ACTIVE)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  storeAccess    StoreAccess[]

  @@unique([organizationId, userId])
  @@index([userId, status])
}

model StoreAccess {
  id           String     @id @default(cuid())
  membershipId String
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Restrict)
  storeId      String
  store        Store      @relation(fields: [storeId], references: [id], onDelete: Restrict)
  createdAt    DateTime   @default(now())

  @@unique([membershipId, storeId])
  @@index([userId, storeId])
}

model CashSession {
  id             String            @id @default(cuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  storeId        String
  store          Store             @relation(fields: [storeId], references: [id], onDelete: Restrict)
  userId         String
  user           User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  status         CashSessionStatus @default(OPEN)
  openingAmount  Decimal           @db.Decimal(14, 2)
  closingAmount  Decimal?          @db.Decimal(14, 2)
  openedAt       DateTime          @default(now())
  closedAt       DateTime?
  sales          Sale[]

  @@index([organizationId, storeId, status])
}

model Sale {
  id             String              @id @default(cuid())
  organizationId String
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  storeId        String
  store          Store               @relation(fields: [storeId], references: [id], onDelete: Restrict)
  cashSessionId  String
  cashSession    CashSession         @relation(fields: [cashSessionId], references: [id], onDelete: Restrict)
  customerId     String?
  customer       Customer?           @relation(fields: [customerId], references: [id], onDelete: Restrict)
  actorId        String
  actor          User                @relation(fields: [actorId], references: [id], onDelete: Restrict)
  idempotencyKey String
  status         SaleStatus          @default(CONFIRMED)
  grossTotal     Decimal             @db.Decimal(14, 2)
  discountTotal  Decimal             @default(0) @db.Decimal(14, 2)
  netTotal       Decimal             @db.Decimal(14, 2)
  notes          String?
  confirmedAt    DateTime            @default(now())
  canceledAt     DateTime?
  items          SaleItem[]
  payments       SalePayment[]
  cancellation   SaleCancellation?
  returns        SaleReturn[]
  receivables    AccountReceivable[]

  @@unique([organizationId, storeId, idempotencyKey])
  @@index([organizationId, storeId, confirmedAt])
}

model SaleItem {
  id               String           @id @default(cuid())
  saleId           String
  sale             Sale             @relation(fields: [saleId], references: [id], onDelete: Restrict)
  productId        String?
  product          Product?         @relation(fields: [productId], references: [id], onDelete: Restrict)
  serviceId        String?
  service          Service?         @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  description      String
  quantity         Decimal          @db.Decimal(14, 3)
  unitPrice        Decimal          @db.Decimal(14, 2)
  unitCostSnapshot Decimal          @db.Decimal(14, 4)
  grossTotal       Decimal          @db.Decimal(14, 2)
  discountTotal    Decimal          @default(0) @db.Decimal(14, 2)
  netTotal         Decimal          @db.Decimal(14, 2)
  returnItems      SaleReturnItem[]

  @@index([saleId])
  @@index([productId])
}

model SalePayment {
  id        String        @id @default(cuid())
  saleId    String
  sale      Sale          @relation(fields: [saleId], references: [id], onDelete: Restrict)
  method    PaymentMethod
  amount    Decimal       @db.Decimal(14, 2)
  createdAt DateTime      @default(now())

  @@index([saleId])
}

model SaleCancellation {
  id         String   @id @default(cuid())
  saleId     String   @unique
  sale       Sale     @relation(fields: [saleId], references: [id], onDelete: Restrict)
  reason     String
  actorId    String
  canceledAt DateTime @default(now())
}

model SaleReturn {
  id        String           @id @default(cuid())
  saleId    String
  sale      Sale             @relation(fields: [saleId], references: [id], onDelete: Restrict)
  reason    String
  amount    Decimal          @db.Decimal(14, 2)
  actorId   String
  createdAt DateTime         @default(now())
  items     SaleReturnItem[]

  @@index([saleId, createdAt])
}

model SaleReturnItem {
  id           String     @id @default(cuid())
  saleReturnId String
  saleReturn   SaleReturn @relation(fields: [saleReturnId], references: [id], onDelete: Restrict)
  saleItemId   String
  saleItem     SaleItem   @relation(fields: [saleItemId], references: [id], onDelete: Restrict)
  quantity     Decimal    @db.Decimal(14, 3)
  amount       Decimal    @db.Decimal(14, 2)

  @@index([saleItemId])
}

model AccountReceivable {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  storeId        String
  store          Store            @relation(fields: [storeId], references: [id], onDelete: Restrict)
  saleId         String
  sale           Sale             @relation(fields: [saleId], references: [id], onDelete: Restrict)
  customerId     String
  customer       Customer         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  amount         Decimal          @db.Decimal(14, 2)
  dueDate        DateTime
  status         ReceivableStatus @default(OPEN)
  createdAt      DateTime         @default(now())
  paidAt         DateTime?

  @@index([organizationId, storeId, status, dueDate])
}

model AuditEvent {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  storeId        String?
  store          Store?       @relation(fields: [storeId], references: [id], onDelete: Restrict)
  actorId        String?
  action         String
  entityType     String
  entityId       String
  metadata       Json?
  occurredAt     DateTime     @default(now())

  @@index([organizationId, occurredAt])
  @@index([organizationId, entityType, entityId])
}
