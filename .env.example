# Local PostgreSQL. Copy to .env and replace values outside development.
POSTGRES_DB=flux_pet
POSTGRES_USER=flux_pet
POSTGRES_PASSWORD=local-development-only
DATABASE_URL=postgresql://flux_pet:local-development-only@127.0.0.1:5434/flux_pet?schema=public

APP_ENV=development
LOG_LEVEL=info
APP_TIMEZONE=America/Sao_Paulo
